{
  "name": "@pasky/muaddib",
  "version": "2.4.0",
  "type": "module",
  "description": "Secure, multi-user AI assistant for IRC, Discord, and Slack",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "muaddib": "./dist/app/main.js",
    "muaddib-message": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "config.json.example",
    "auth.json.example",
    "scripts/patch-pi-ai.mjs",
    "scripts/patch-gondolin.mjs",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/agent/tools/artifact-viewer.html src/agent/tools/artifact-htaccess dist/agent/tools/ && for d in src/agent/skills/*/; do [ -f \"$d/SKILL.md\" ] && mkdir -p \"dist/agent/skills/$(basename \"$d\")\" && cp \"$d/SKILL.md\" \"dist/agent/skills/$(basename \"$d\")/\"; done && printf '# Overrides dist/.gitignore so npm publish includes dist/\\n*.whl\\n*.tar.gz\\n' > dist/.npmignore",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/patch-pi-ai.mjs && node scripts/patch-gondolin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\"",
    "test": "scripts/run-vitest.sh",
    "cli:message": "node --disable-sigusr1 ./dist/cli/main.js",
    "start": "node --disable-sigusr1 ./dist/app/main.js",
    "start:irc": "node --disable-sigusr1 ./dist/app/main.js"
  },
  "keywords": [
    "ai",
    "assistant",
    "pi",
    "pi-coding-agent",
    "irc",
    "discord",
    "slack",
    "claude",
    "anthropic",
    "chatbot",
    "multi-user"
  ],
  "author": "Petr Baudis <pasky@ucw.cz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pasky/muaddib.git"
  },
  "homepage": "https://github.com/pasky/muaddib#readme",
  "bugs": {
    "url": "https://github.com/pasky/muaddib/issues"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.14.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@slack/bolt": "^5.1.0",
    "croner": "^11.0.0",
    "discord.js": "^14.28.1",
    "typebox": "^1.4.6"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
